
.gitattributes text eol=lf

# Use bd merge for beads JSONL files
.beads/issues.jsonl merge=beads

# i18n generators emit deterministic LF JSON bundles on every platform.
frontend/src/i18n/messages/generated/*.json text eol=lf
admin/src/i18n/messages/generated/*.json text eol=lf
partner/src/i18n/messages/generated/*.json text eol=lf
scripts/remnawave/templates/cybervpn-premium-smart-ru-incy-xray*.json text eol=lf

# The Remnawave TZ bundle manifest hashes raw bytes, so keep its artifacts LF-stable.
docs/plans/TZ_Codex_Task1_Premium_Smart_RU_Remnawave_2_8_0.md text eol=lf
docs/plans/TZ_Codex_Task2_SPB_Default_With_DE_Exceptions_Remnawave_2_8_0.md text eol=lf
docs/plans/README_CyberVPN_Remnawave_TZ.md text eol=lf
docs/plans/CyberVPN_Remnawave_2_8_0_TZ_manifest.json text eol=lf
docs/architecture/CYBERVPN_PREMIUM_SMART_RU_CURRENT_PRODUCTION_ARCHITECTURE.md text eol=lf
docs/evidence/releases/task1-task2-20260712/final-main-production-audit-20260712.md text eol=lf
docs/evidence/releases/task1-task2-20260713/task2-runtime-fault-v2/* text eol=lf
scripts/testing/check-remnawave-tz-evidence.py text eol=lf
scripts/testing/check-task2-cloudflare-dns.py text eol=lf

# Release and container entrypoints should stay LF on Windows workstations.
*.sh text eol=lf
*.bash text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.yml.template text eol=lf
Dockerfile text eol=lf
**/Dockerfile text eol=lf
Dockerfile.* text eol=lf
**/Dockerfile.* text eol=lf
*.Dockerfile text eol=lf
Cargo.lock text eol=lf
**/Cargo.lock text eol=lf
Cargo.toml text eol=lf
**/Cargo.toml text eol=lf
