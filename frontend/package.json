{
  "name": "vpn-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:i18n": "node ./scripts/generate-message-bundles.mjs",
    "prepare:workspace": "bash ./scripts/ensure-local-next-deps.sh",
    "predev": "npm run prepare:workspace && npm run prepare:i18n",
    "dev": "node ./scripts/dev-server.mjs",
    "prebuild": "npm run prepare:i18n",
    "build": "next build --turbopack",
    "start": "next start",
    "start:prod-like": "bash ./scripts/start-prod-like.sh",
    "prelint": "npm run prepare:i18n",
    "lint": "eslint",
    "pretest": "npm run prepare:i18n",
    "test": "vitest",
    "pretest:run": "npm run prepare:i18n",
    "test:run": "vitest run",
    "pretest:mobile-layout": "npm run prepare:i18n",
    "test:mobile-layout": "vitest run src/__tests__/mobile-layout-regressions.test.tsx",
    "pretest:coverage": "npm run prepare:i18n",
    "test:coverage": "vitest run --coverage",
    "check:seo": "node scripts/seo-static-audit.mjs",
    "precheck:i18n:s1": "npm run prepare:i18n",
    "check:i18n:s1": "node scripts/stage1-i18n-critical-path-audit.mjs",
    "check:marketing:s1": "node scripts/stage1-marketing-critical-pages-audit.mjs",
    "check:login-passkey-smoke": "node ../scripts/testing/auth-login-browser-smoke.mjs --surface=frontend",
    "check:bff-cookie-smoke": "node ../scripts/testing/auth-bff-cookie-session-smoke.mjs --surface=frontend",
    "check:route-browser-smoke": "node ../scripts/testing/web-route-coverage-browser-smoke.mjs --surface=frontend",
    "check:mobile-performance": "node scripts/mobile-performance-budget.mjs",
    "check:mobile": "npm run test:mobile-layout && npm run check:mobile-performance",
    "generate:api-types": "node scripts/generate-api-types.mjs"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "1.2.3",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "@react-three/postprocessing": "3.0.4",
    "@sentry/nextjs": "10.67.0",
    "@simplewebauthn/browser": "13.3.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-table": "8.21.3",
    "@types/qrcode": "1.5.6",
    "axios": "1.18.1",
    "babel-plugin-react-compiler": "1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "country-flag-icons": "1.6.20",
    "html-to-image": "1.11.13",
    "input-otp": "1.4.2",
    "lenis": "1.3.25",
    "lucide-react": "1.25.0",
    "motion": "12.42.2",
    "next": "16.2.11",
    "next-intl": "4.13.3",
    "postcss": "8.5.22",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-qr-code": "2.2.0",
    "schema-dts": "2.0.0",
    "tailwind-merge": "3.6.0",
    "three": "0.185.1",
    "web-vitals": "5.3.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query-devtools": "5.101.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "eslint-config-next": "16.2.11",
    "happy-dom": "20.11.0",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "overrides": {
    "follow-redirects": "1.16.0"
  }
}
