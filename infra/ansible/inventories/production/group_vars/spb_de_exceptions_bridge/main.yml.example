---
# Example only. Do not store real secrets in group vars.
spb_de_exceptions_bridge_enabled: false
spb_de_exceptions_bridge_action: deploy
spb_de_exceptions_bridge_port: 9444
spb_de_exceptions_bridge_inbound_tag: DE_SPB_EXCEPTIONS_BRIDGE_9444
spb_de_exceptions_bridge_outbound_tag: DE_EXCEPTIONS_BRIDGE

# Dedicated SPB listener IPv6 used by the internal bridge transport.
spb_de_exceptions_bridge_allowed_ipv4_cidrs: []
spb_de_exceptions_bridge_allowed_ipv6_cidrs:
  - 2a01:e5c0:1368::3/128

# Bridge credentials live in Remnawave/OpenBao/Ansible Vault and are consumed
# by the Remnawave operator/runtime, not by this firewall role.
