table inet {{ spb_de_exceptions_bridge_nftables_table_name }} {
{% if spb_de_exceptions_bridge_allowed_ipv4_cidrs | length > 0 %}
  set spb_ipv4 {
    type ipv4_addr
    flags interval
    elements = { {{ spb_de_exceptions_bridge_allowed_ipv4_cidrs | join(', ') }} }
  }
{% endif %}
{% if spb_de_exceptions_bridge_allowed_ipv6_cidrs | length > 0 %}
  set spb_ipv6 {
    type ipv6_addr
    flags interval
    elements = { {{ spb_de_exceptions_bridge_allowed_ipv6_cidrs | join(', ') }} }
  }
{% endif %}

  chain input {
    type filter hook input priority 0; policy accept;
{% if spb_de_exceptions_bridge_allowed_ipv4_cidrs | length > 0 %}
    tcp dport {{ spb_de_exceptions_bridge_port }} ip saddr @spb_ipv4 accept
    udp dport {{ spb_de_exceptions_bridge_port }} ip saddr @spb_ipv4 accept
{% endif %}
{% if spb_de_exceptions_bridge_allowed_ipv6_cidrs | length > 0 %}
    tcp dport {{ spb_de_exceptions_bridge_port }} ip6 saddr @spb_ipv6 accept
    udp dport {{ spb_de_exceptions_bridge_port }} ip6 saddr @spb_ipv6 accept
{% endif %}
    tcp dport {{ spb_de_exceptions_bridge_port }} counter drop
    udp dport {{ spb_de_exceptions_bridge_port }} counter drop
  }
}
