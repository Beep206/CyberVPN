[Unit]
Description=CyberVPN Task2 SPB dedicated listener IPv6 address
Documentation=https://github.com/Beep206/CyberVPN
Wants=network-online.target
After=network-online.target
Before=remnanode.service remnanode@.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
UMask=0027
RuntimeDirectory={{ spb_listener_ipv6_address_runtime_directory }}
RuntimeDirectoryMode=0755
ExecStart={{ spb_listener_ipv6_address_script_path }} ensure
ExecStop={{ spb_listener_ipv6_address_script_path }} remove
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectSystem=strict
ReadWritePaths={{ spb_listener_ipv6_address_state_dir }}
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=
MemoryMax={{ spb_listener_ipv6_address_unit_memory_max }}
TasksMax={{ spb_listener_ipv6_address_unit_tasks_max }}

[Install]
WantedBy=multi-user.target
