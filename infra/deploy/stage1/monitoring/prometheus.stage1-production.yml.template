global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    environment: production
    stage: s1
    site: prod-app-1

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093

rule_files:
  - /etc/prometheus/rules/stage1_dashboard_recording_rules.yml
  - /etc/prometheus/rules/stage1_alerts.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - 127.0.0.1:9090
        labels:
          service: prometheus

  - job_name: remnawave
    metrics_path: /metrics
    scrape_interval: 15s
    basic_auth:
      username: ${REMNAWAVE_METRICS_USER}
      password: ${REMNAWAVE_METRICS_PASS}
    static_configs:
      - targets:
          - remnawave:3001
        labels:
          service: cybervpn-remnawave
          environment: production
          stage: s1
