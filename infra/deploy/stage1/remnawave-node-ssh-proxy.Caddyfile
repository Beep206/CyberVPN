{
	admin off
	auto_https off
}

:8080 {
	# Never persist the broker secret or one-time WebSocket subprotocol values.
	log {
		output discard
	}

	@health path /internal/health
	handle @health {
		respond 204
	}

	@scoped_broker path /api/cybervpn/node-ssh/tickets/* /api/cybervpn/node-ssh/ws
	handle @scoped_broker {
		reverse_proxy http://cybervpn-remnawave:3000 {
			header_up X-Remnawave-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Host {upstream_hostport}
			header_up X-Forwarded-Proto http
		}
	}

	respond 404
}
