APP_PORT=3000
METRICS_PORT=3001
API_INSTANCES=1

POSTGRES_USER=remnawave
POSTGRES_PASSWORD=replace-with-production-secret
POSTGRES_DB=remnawave
DATABASE_URL=postgresql://remnawave:replace-with-production-secret@cybervpn-remnawave-postgres:5432/remnawave

REDIS_HOST=cybervpn-remnawave-valkey
REDIS_PORT=6379

# Preserve the exact previous JWT_AUTH_SECRET value when upgrading from 2.x.
APP_SECRET=

EXPORT_TO_STREAM_ENABLED=true
EXPORT_TO_STREAM_MAXLEN=3000

SHORT_UUID_METHOD=nanoid
SHORT_UUID_LENGTH=16
# SHORT_UUID_CUSTOM_PATTERN={hex:16}-{hex:16}

# Browser SSH is enabled through Docker Compose environment only after the
# backend passkey flags and explicit trusted-admin/node UUID allowlists are set.
# The scoped broker secret is never APP_SECRET, an API token, or a JWT secret.
CYBERVPN_NODE_SSH_BROKER_ENABLED=false
CYBERVPN_NODE_SSH_BROKER_SECRET=
CYBERVPN_NODE_SSH_BROKER_TRUSTED_PROXY_RANGES=172.30.8.3
# Required at render/deploy time. Use the promoted CyberVPN mirror by registry
# digest; a raw upstream Caddy tag/digest is not an accepted release artifact.
CYBERVPN_NODE_SSH_PROXY_IMAGE=

PANEL_DOMAIN=remnawave.internal.cyber-vpn.net
FRONT_END_DOMAIN=remnawave.internal.cyber-vpn.net
SUB_PUBLIC_DOMAIN=cyber-vpn.org/api/sub

METRICS_USER=admin
METRICS_PASS=replace-with-production-secret

WEBHOOK_ENABLED=false
WEBHOOK_URL=https://api.cyber-vpn.net/api/v1/webhooks/remnawave
WEBHOOK_SECRET_HEADER=TODO_SET_RUNTIME_VALUE

IS_TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=replace-with-telegram-token-if-enabled
TELEGRAM_NOTIFY_USERS=replace-with-chat-id-if-enabled
TELEGRAM_NOTIFY_NODES=replace-with-chat-id-if-enabled
TELEGRAM_NOTIFY_CRM=replace-with-chat-id-if-enabled
TELEGRAM_NOTIFY_SERVICE=replace-with-chat-id-if-enabled
TELEGRAM_NOTIFY_TBLOCKER=replace-with-chat-id-if-enabled
