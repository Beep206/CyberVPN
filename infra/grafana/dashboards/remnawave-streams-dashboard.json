{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Remnawave 3.4.3 operations runbook",
      "type": "link",
      "url": "https://github.com/Beep206/CyberVPN/blob/main/docs/runbooks/REMNAWAVE_3_4_3_UPGRADE.md"
    }
  ],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 100}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (stream) (cybervpn_remnawave_stream_pending_current{stream=~\"$stream\"})",
          "instant": true,
          "legendFormat": "{{stream}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Pending entries",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 300},
              {"color": "red", "value": 900}
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "clamp_min(time() - cybervpn_remnawave_stream_last_consumed_unixtime{stream=~\"$stream\"}, 0)",
          "instant": true,
          "legendFormat": "{{stream}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Seconds since last consumed entry",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 60},
              {"color": "red", "value": 300}
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, stream) (rate(cybervpn_remnawave_stream_message_lag_seconds_bucket{stream=~\"$stream\"}[15m])))",
          "instant": true,
          "legendFormat": "{{stream}} p95",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Event lag p95",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "max(cybervpn_remnawave_stream_retention_backlog)",
          "instant": true,
          "legendFormat": "backlog",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Retention backlog",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "id": 5,
      "options": {
        "legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (stream, outcome) (rate(cybervpn_remnawave_stream_messages_total{stream=~\"$stream\"}[5m]))",
          "legendFormat": "{{stream}} / {{outcome}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Terminal and retry outcomes",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "id": 6,
      "options": {
        "legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (stream, outcome) (increase(cybervpn_remnawave_stream_reclaimed_total{stream=~\"$stream\"}[$__rate_interval]))",
          "legendFormat": "reclaimed {{stream}} / {{outcome}}",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "sum by (stream, reason) (increase(cybervpn_remnawave_stream_parse_failures_total{stream=~\"$stream\"}[$__rate_interval]))",
          "legendFormat": "parse {{stream}} / {{reason}}",
          "range": true,
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "sum by (stream, reason) (increase(cybervpn_remnawave_stream_dead_letters_total{stream=~\"$stream\"}[$__rate_interval]))",
          "legendFormat": "DLQ {{stream}} / {{reason}}",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "Reclaim, parse failures and redacted DLQ",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["cybervpn", "remnawave", "redis-streams", "operations"],
  "templating": {
    "list": [
      {
        "current": {"selected": false, "text": "Prometheus", "value": "prometheus"},
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      },
      {
        "allValue": ".*",
        "current": {"selected": true, "text": ["All"], "value": ["$__all"]},
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "definition": "label_values(cybervpn_remnawave_stream_pending_current, stream)",
        "hide": 0,
        "includeAll": true,
        "label": "Stream",
        "multi": true,
        "name": "stream",
        "options": [],
        "query": {"query": "label_values(cybervpn_remnawave_stream_pending_current, stream)", "refId": "StandardVariableQuery"},
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Remnawave Redis Streams",
  "uid": "remnawave-streams",
  "version": 1,
  "weekStart": ""
}
