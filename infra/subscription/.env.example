APP_PORT=3010
REMNAWAVE_PANEL_URL=http://remnawave:3000
# Create a dedicated read-only token for subscription metadata/config access.
# Do not reuse the backend, worker, Helix, or operator token.
REMNAWAVE_API_TOKEN=CHANGE_ME_PANEL_API_TOKEN
CUSTOM_SUB_PREFIX=api/sub
# A single Caddy hop is the local Compose contract. Review this value if the
# proxy topology changes; never use true on an Internet-facing container.
TRUST_PROXY=1
MARZBAN_LEGACY_LINK_ENABLED=false
