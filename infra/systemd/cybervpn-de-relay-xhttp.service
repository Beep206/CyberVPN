[Unit]
Description=Proxy CyberVPN DE XHTTP Reality ingress to the DE node
Documentation=man:systemd-socket-proxyd(8)
Requires=cybervpn-de-relay-xhttp.socket
After=network-online.target

[Service]
ExecStart=/lib/systemd/systemd-socket-proxyd --connections-max=4096 --exit-idle-time=5min 138.124.115.206:8443
DynamicUser=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectSystem=strict
NoNewPrivileges=true
RestrictAddressFamilies=AF_INET
LimitNOFILE=16384
MemoryMax=128M
TasksMax=512

[Install]
WantedBy=multi-user.target
