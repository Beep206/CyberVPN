{
  "blocks": {
    "ads": true,
    "quic_doq": "block",
    "smtp_abuse_ports": [
      25,
      465,
      587
    ],
    "tor": "best_effort",
    "torrent": true,
    "trackers": true
  },
  "product": "premium_smart_ru",
  "regions": {
    "eu": {
      "fallback": "nl",
      "primary": "de"
    },
    "ru": {
      "fallback": "moscow",
      "primary": "spb"
    }
  },
  "routes": {
    "default": "eu",
    "eu_exceptions": "eu",
    "private": "direct",
    "ru_services": "ru"
  },
  "rules": [
    {
      "action": "direct",
      "assurance": "enforced",
      "id": "direct_private",
      "source_group": "private_networks",
      "stage": "private_networks"
    },
    {
      "action": "direct",
      "assurance": "enforced",
      "id": "direct_approved_processes",
      "source_group": "direct_processes",
      "stage": "direct_processes"
    },
    {
      "action": "block",
      "assurance": "enforced",
      "id": "block_bittorrent_protocol",
      "source_group": "bittorrent_protocol",
      "stage": "bittorrent_protocol"
    },
    {
      "action": "block",
      "assurance": "enforced",
      "id": "block_torrent_processes",
      "source_group": "torrent_processes",
      "stage": "torrent_processes"
    },
    {
      "action": "block",
      "assurance": "enforced",
      "id": "block_torrent_sources",
      "source_group": "torrent_sources",
      "stage": "torrent_sources"
    },
    {
      "action": "block",
      "assurance": "enforced",
      "id": "block_ads_trackers",
      "source_group": "ads_trackers",
      "stage": "ads_trackers"
    },
    {
      "action": "block",
      "assurance": "best_effort",
      "id": "block_tor_best_effort",
      "source_group": "tor",
      "stage": "tor"
    },
    {
      "action": "block",
      "assurance": "enforced",
      "id": "block_quic_doq",
      "source_group": "quic_doq",
      "stage": "quic_doq"
    },
    {
      "action": "eu",
      "assurance": "enforced",
      "id": "route_eu_exceptions",
      "source_group": "eu_exceptions",
      "stage": "eu_exceptions"
    },
    {
      "action": "ru",
      "assurance": "enforced",
      "id": "route_ru_services",
      "source_group": "ru_services",
      "stage": "ru_services"
    },
    {
      "action": "ru",
      "assurance": "enforced",
      "id": "route_broad_ru",
      "source_group": "broad_ru",
      "stage": "broad_ru"
    },
    {
      "action": "eu",
      "assurance": "enforced",
      "id": "route_final_eu",
      "network": "tcp,udp",
      "stage": "final"
    }
  ],
