# =============================================================================
# CyberVPN Task Worker — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the required values.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:local_dev_postgres@remnawave-db:5432/postgres

# --- Redis / Valkey ---
REDIS_URL=redis://remnawave-redis:6379/0

# --- Remnawave VPN Backend ---
REMNAWAVE_URL=http://remnawave:3000
REMNAWAVE_API_TOKEN=your_remnawave_api_token_here

# --- CyberVPN Backend Internal Jobs ---
BACKEND_API_URL=http://cybervpn-backend:8000/api/v1
BACKEND_INTERNAL_SECRET=
PAYMENT_SETTLEMENT_WORKER_SECRET=
PAYMENT_COMPLETED_PARTNER_EARNINGS_ENABLED=true
PAYMENT_COMPLETED_PARTNER_EARNINGS_BATCH_LIMIT=25

# Remnawave 3.4 Redis export consumer. Enable only after the backend internal
# ingestion endpoint and its migrations are deployed. This must point at the
# dedicated Remnawave export Valkey, never the TaskIQ/cache REDIS_URL above.
REMNAWAVE_STREAM_CONSUMER_ENABLED=false
REMNAWAVE_STREAM_REDIS_URL=redis://cybervpn-remnawave-valkey:6379/0
REMNAWAVE_STREAM_IP_HMAC_SECRET=
REMNAWAVE_STREAM_CONSUMER_GROUP=cybervpn-remnawave-v1
REMNAWAVE_STREAM_READ_COUNT=50
REMNAWAVE_STREAM_BLOCK_MS=5000
REMNAWAVE_STREAM_RECLAIM_COUNT=50
REMNAWAVE_STREAM_RECLAIM_MIN_IDLE_MS=30000
REMNAWAVE_STREAM_MAX_DELIVERY_ATTEMPTS=5
REMNAWAVE_STREAM_DLQ_MAXLEN=3000
REMNAWAVE_STREAM_RECEIPT_RETENTION_DAYS=14
REMNAWAVE_STREAM_CHECKPOINT_OBSERVE_INTERVAL_SECONDS=30
REMNAWAVE_STREAM_RETENTION_ENABLED=false
REMNAWAVE_STREAM_RETENTION_BATCH_LIMIT=1000
REMNAWAVE_STREAM_RETENTION_MAX_BATCHES=20

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
ADMIN_TELEGRAM_IDS=123456789,987654321

# --- CryptoBot Payments ---
CRYPTOBOT_TOKEN=your_cryptobot_api_token_here
# `testnet` is allowed only for local/staging sandbox evidence.
# Production rejects CRYPTOBOT_NETWORK=testnet at startup.
CRYPTOBOT_NETWORK=mainnet

# --- Worker Configuration ---
WORKER_CONCURRENCY=2
RESULT_TTL_SECONDS=3600
STAGE1_PROVISIONING_RETRY_CLAIMING_ENABLED=false
STAGE1_PROVISIONING_RETRY_BATCH_LIMIT=25
LOG_LEVEL=INFO
ENVIRONMENT=development
SENTRY_DSN=
SENTRY_RELEASE=

# --- Notification Settings ---
NOTIFICATION_MAX_RETRIES=5
NOTIFICATION_BATCH_SIZE=50

# --- Email Delivery ---
# cyber-vpn.net SMTP is the primary route for auth/system mail.
SMTP_HOST=mail.cyber-vpn.net
# Default submission is 587. Production app hosts with standard SMTP egress
# restrictions should use the documented alternative submission port 2587.
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_AUTH_USERNAME=noreply@cyber-vpn.net
SMTP_AUTH_PASSWORD=
SMTP_SYSTEM_FROM_EMAIL=CyberVPN <noreply@cyber-vpn.net>
SMTP_BILLING_FROM_EMAIL=CyberVPN Billing <billing@cyber-vpn.net>
SMTP_SUPPORT_FROM_EMAIL=CyberVPN Support <support@cyber-vpn.net>

# Resend is disabled by default and only used for explicit retry/fallback policy.
EMAIL_RESEND_FALLBACK_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=CyberVPN <verify@email.cyber-vpn.net>
BREVO_API_KEY=
BREVO_FROM_EMAIL=CyberVPN <noreply@email.cyber-vpn.net>
MAGIC_LINK_BASE_URL=http://localhost:9001
EMAIL_DEV_MODE=false
EMAIL_VERIFIED_SENDER_DOMAINS=cyber-vpn.net

# --- Health Check ---
HEALTH_CHECK_INTERVAL_SECONDS=120

# --- Cleanup Retention ---
CLEANUP_AUDIT_RETENTION_DAYS=90
CLEANUP_WEBHOOK_RETENTION_DAYS=30

# --- Bulk Operations ---
BULK_BATCH_SIZE=50

# --- Monitoring ---
METRICS_PORT=9090
METRICS_PROTECT=false
